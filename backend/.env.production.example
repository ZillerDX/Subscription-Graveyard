# Production Environment Variables
# Copy this file to .env.production and fill in your actual values

# Application
PROJECT_NAME=Subscription Graveyard API
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
# Replace with your production database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@host:5432/subscription_graveyard

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security
# Generate a secure secret key (use: openssl rand -hex 32)
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Password Hashing
BCRYPT_ROUNDS=12

# CORS
# Add your production frontend URL(s), comma-separated
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# Optional: Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Optional: Sentry (Error Tracking)
# SENTRY_DSN=your-sentry-dsn-here
